# Discord bot credentials — copy this file to `.env` and fill in the values.
# See README.md for where to find each one in the Discord Developer Portal.

# Bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> your app -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# Your server's ID (Discord -> right-click the server -> Copy Server ID; requires Developer Mode)
DISCORD_GUILD_ID=
